// ============================================================================
// perfil Nextflow para o cluster SLURM em que a corrida foi feita (adaptar).
//
// Partições reais (sinfo, 2026-08-25):
//   bigmem    4 nós    2.062.797 MB   14 dias
//   compute  41 nós      256.538 MB   14 dias
//   gpu      14 nós      514.984 MB   14 dias
//   quickq   46 nós      256.538 MB   12 h
//
// O job driver roda na compute e submete cada etapa como job próprio.
// Só montagem e DIAMOND vão para a bigmem; o resto cabe folgado na compute.
//
// NOTA: sem check_max(). As versões novas do template nf-core removeram essa
// função e um config que a chame quebra logo no início da corrida.
// O equivalente atual é resourceLimits.
// ============================================================================

process {
    executor      = 'slurm'
    queue         = 'compute'
    scratch       = true
    maxRetries    = 2

    // Só tenta de novo em falha de recurso (OOM, timeout, nó morto).
    // Erro de verdade no software deve parar a corrida, não repetir 3x.
    errorStrategy = { task.exitStatus in [104,134,137,139,140,143,247] ? 'retry' : 'finish' }

    // Teto absoluto: o Nextflow nunca pede mais que isto, nem ao repetir.
    resourceLimits = [ cpus: 32, memory: 2000.GB, time: 14.d ]

    // ---- Montagem: a única etapa que realmente precisa do nó grande --------
    // 18 amostras juntas, ~260 M reads depois da remoção de rRNA.
    withName: '.*MEGAHIT.*' {
        queue  = 'bigmem'
        cpus   = 32
        memory = { 900.GB * task.attempt }
        time   = { 96.h }
    }

    // ---- DIAMOND carrega o índice UniRef90 de 93 GB -----------------------
    withName: '.*DIAMOND.*' {
        queue  = 'bigmem'
        cpus   = 32
        memory = { 250.GB * task.attempt }
        time   = { 72.h }
    }

    // ---- Etapas que cabem na compute --------------------------------------
    withName: '.*BBDUK.*' {                 // filtro de rRNA por k-mer
        cpus = 8;  memory = { 64.GB  * task.attempt }; time = { 12.h }
    }
    withName: '.*BBMAP.*' {                 // mapeia reads de volta à assembly
        cpus = 16; memory = { 150.GB * task.attempt }; time = { 24.h }
    }
    withName: '.*TRANSDECODER.*' {
        cpus = 8;  memory = { 64.GB  * task.attempt }; time = { 48.h }
    }
    withName: '.*EGGNOG.*' {
        cpus = 16; memory = { 120.GB * task.attempt }; time = { 48.h }
    }
    withName: '.*KOFAM.*' {
        cpus = 16; memory = { 64.GB  * task.attempt }; time = { 48.h }
    }
}

executor {
    // Não inundar o escalonador. São só 4 nós bigmem; deixar o Nextflow
    // disparar centenas de jobs de uma vez irrita o admin e não acelera nada.
    queueSize       = 20
    submitRateLimit = '10/1min'
}

apptainer {
    enabled    = true
    autoMounts = true
    // Sem este bind os containers não enxergam nem os reads nem os bancos.
    runOptions = '-B /mmfs1'
}

// Registro do custo real de cada etapa. Serve para a seção de métodos e para
// dimensionar a corrida da fase 2 com rnaSPAdes.
trace {
    enabled   = true
    overwrite = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,peak_rss,peak_vmem'
}

// Numérico vindo da CLI chega como String e quebra a comparação em
// workflows/metatdenovo.nf:381. Declarado aqui, é Integer de verdade.
params {
    min_contig_length = 300
}
